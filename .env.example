GHOSTSHELL_MODEL=gemma3:1b
GHOSTSHELL_OLLAMA_URL=http://127.0.0.1:11434
GHOSTSHELL_REQUEST_TIMEOUT=25
GHOSTSHELL_COMMAND_TIMEOUT=15
GHOSTSHELL_OUTPUT_LIMIT=64000
GHOSTSHELL_HISTORY_LIMIT=30
# Optional: comma-separated browser origins for local development.
GHOSTSHELL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: defaults to ~/.ghostshell/ghostshell.db
# GHOSTSHELL_DATABASE=C:\Users\you\.ghostshell\ghostshell.db
